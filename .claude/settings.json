{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(pytest *)",
      "Bash(mypy *)",
      "Bash(pip install *)",
      "Bash(uv *)",
      "Bash(git *)",
      "Bash(mkdir *)",
      "Bash(rm *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(python *)",
      "Bash(python3 *)"
    ],
    "deny": [],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(npm *)",
      "Bash(pip *)",
      "Bash(pip3 *)"
    ]
  },
  "permissionMode": "acceptEdits",
  "maxTurns": 50,
  "theme": "dark",
  "respectGitignore": true,
  "spinnerTipsEnabled": true
}
