{
  "$schema": "https://code.claude.com/schemas/settings.json",
  "model": "sonnet",
  "disableAllHooks": false,
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(pytest *)",
      "Bash(mypy *)",
      "Bash(pip install *)",
      "Bash(uv *)",
      "Bash(git *)",
      "Bash(mkdir *)",
      "Bash(rm *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "mcp__playwright__*",
      "mcp__context7__*",
      "mcp__deepwiki__*"
    ],
    "deny": [],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(npm *)",
      "Bash(pip *)",
      "Bash(pip3 *)"
    ]
  },
  "permissionMode": "acceptEdits",
  "maxTurns": 50,
  "theme": "dark",
  "respectGitignore": true,
  "enableAllProjectMcpServers": true,
  "spinnerTipsEnabled": true,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "优化代码结构",
      "查阅文档",
      "思考最佳方案",
      "检查类型安全",
      "编写测试用例",
      "分析代码影响",
      "打磨代码质量",
      "生成技术方案"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo CCproject",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "PostToolUse"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "PostToolUseFailure"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "PostToolBatch"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "UserPromptSubmit"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "UserPromptExpansion"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "Notification"
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "MessageDisplay"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "Stop"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "SubagentStart"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "SubagentStop"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "once": true,
            "statusMessage": "PreCompact"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "PostCompact"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "async": true,
            "once": true,
            "statusMessage": "SessionStart"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "once": true,
            "statusMessage": "SessionEnd"
          }
        ]
      }
    ],
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 30000,
            "async": true,
            "statusMessage": "Setup"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "PermissionRequest"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "PermissionDenied"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "TaskCreated"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/scripts/hooks.py",
            "timeout": 3000,
            "async": true,
            "statusMessage": "TaskCompleted"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "Generated with Claude Code"
  },
  "outputStyle": "Explanatory",
  "plansDirectory": "./reports",
  "spinnerTipsOverride": {
    "tips": [
      "提示: 用 /dev-plan 先出方案再编码",
      "提示: 上下文到 50% 时 /compact",
      "提示: 试试 /goal 让 Claude 自动完成目标",
      "提示: @context7 查库文档避免幻觉"
    ],
    "excludeDefault": false
  }
}
