{
  "$schema": "https://code.claude.com/schemas/settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(pytest *)",
      "Bash(mypy *)",
      "Bash(pip install *)",
      "Bash(uv *)",
      "Bash(git *)",
      "Bash(mkdir *)",
      "Bash(rm *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "mcp__chrome-devtools__*"
    ],
    "deny": [],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(npm *)",
      "Bash(pip *)",
      "Bash(pip3 *)"
    ]
  },
  "permissionMode": "acceptEdits",
  "maxTurns": 50,
  "theme": "dark",
  "spinnerTipsEnabled": true,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "优化代码结构",
      "查阅文档",
      "思考最佳方案",
      "检查类型安全",
      "编写测试用例",
      "分析代码影响",
      "打磨代码质量",
      "生成技术方案"
    ]
  },
  "spinnerTipsOverride": {
    "tips": [
      "提示: 用 /dev-plan 先出方案再编码",
      "提示: 上下文到 50% 时 /compact",
      "提示: 试试 /goal 让 Claude 自动完成目标",
      "提示: @context7 查库文档避免幻觉"
    ],
    "excludeDefault": false
  },
  "statusLine": {
    "type": "command",
    "command": "echo CCproject",
    "padding": 0
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "pr": "Generated with Claude Code"
  },
  "outputStyle": "Explanatory",
  "plansDirectory": "./reports"
}
