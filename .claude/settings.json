{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(pytest *)",
      "Bash(mypy *)",
      "Bash(pip install *)",
      "Bash(uv *)",
      "Bash(git *)",
      "Bash(mkdir *)",
      "Bash(rm *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "mcp__playwright__*",
      "mcp__context7__*",
      "mcp__deepwiki__*"
    ],
    "deny": [],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(npm *)",
      "Bash(pip *)",
      "Bash(pip3 *)"
    ]
  },
  "permissionMode": "acceptEdits",
  "maxTurns": 50,
  "theme": "dark",
  "respectGitignore": true,
  "enableAllProjectMcpServers": true,
  "spinnerTipsEnabled": true,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "优化代码结构",
      "查阅文档",
      "思考最佳方案",
      "检查类型安全",
      "编写测试用例",
      "分析代码影响",
      "打磨代码质量",
      "生成技术方案"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo CCproject",
    "padding": 0
  }
}
