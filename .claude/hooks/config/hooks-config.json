    "Elicitation":          { "type": "beep", "frequency": 650, "duration": 100 },
    "ElicitationResult":    { "type": "beep", "frequency": 850, "duration": 80 },
    "StopFailure":          { "type": "beep", "frequency": 200, "duration": 500 },
    "CwdChanged":           { "type": "beep", "frequency": 700, "duration": 60 },
    "WorktreeCreate":       { "type": "beep", "frequency": 780, "duration": 80 },
    "WorktreeRemove":       { "type": "beep", "frequency": 580, "duration": 100 },
