    "PostToolUseFailure":   { "type": "beep", "frequency": 200, "duration": 400 },
    "PostToolBatch":        { "type": "beep", "frequency": 1100, "duration": 60 },
    "UserPromptSubmit":     { "type": "beep", "frequency": 900, "duration": 100 },
    "UserPromptExpansion":  { "type": "beep", "frequency": 850, "duration": 80 },
    "Notification":         { "type": "beep", "frequency": 1400, "duration": 80 },
    "MessageDisplay":       { "type": "beep", "frequency": 800, "duration": 60 },
    "SubagentStart":        { "type": "beep", "frequency": 1000, "duration": 60 },
    "SubagentStop":         { "type": "beep", "frequency": 700, "duration": 100 },
